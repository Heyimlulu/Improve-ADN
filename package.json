{
  "name": "adn-improver",
  "version": "4.1.0",
  "description": "Browser extension improving the ADN (Animation Digital Network) streaming experience",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "check": "node scripts/check.js",
    "test": "npm run lint && npm run check",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "test:e2e": "node test/e2e/run.mjs",
    "publish:chrome": "node scripts/publish/chrome.js",
    "publish:edge": "node scripts/publish/edge.js",
    "publish:firefox": "node scripts/publish/firefox.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Heyimlulu/Improve-ADN.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "archiver": "^7.0.1",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "playwright": "1.56.1",
    "semver": "^7.6.3"
  }
}
